# Скопируйте на VPS: cp .env.prod.example .env
# Замените все CHANGE_ME на реальные значения.
#
# DOCKER_IMAGE задаётся автоматически в GitHub Actions (remote-deploy.sh).
# Для ручного деплоя без registry оставьте DOCKER_IMAGE пустым — образ соберётся локально.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=educational_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=Educational Platform
APP_VERSION=1.0.0
DEBUG=False

# AI_API_KEY=
